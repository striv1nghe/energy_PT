# BBICloud 会话配置（手动提供 sid 可跳过自动登录）
BBI_SID=
BBI_USERNAME=
BBI_PASSWORD=

# 项目配置
BBI_PROJECT_ID=202607020000000001
BBI_PROJECT_NAME=宁波慈溪凤起潮鸣

# SQLite 数据库路径（留空则默认为 <仓库根>/data/energy_data.db）
BBI_DB_PATH=

# 磁盘空间告警阈值：数据库大小占磁盘总空间的比例（%），默认 50
DISK_ALARM_THRESHOLD_PERCENT=50

# 是否启用后台同步调度器（定时任务：告警60s / 采样15min / 日冻结02:00）
SYNC_DAEMON=false

# 调度器启动时回填最近多少天的 15 分钟采样（补齐停机期间的数据缺口）
BBI_CATCHUP_DAYS=3

# 平台登录账号（公开部署时务必修改）
PLATFORM_USERNAME=admin
PLATFORM_PASSWORD=admin123
# JWT 签名密钥（公开部署时务必改为随机长字符串）
PLATFORM_JWT_SECRET=please-change-this-secret

# API 监听端口
PORT=4000
